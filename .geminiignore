# ==============================================================================
# .geminiignore / .antigravityignore
# Optimized for: Python (uv) + Django + PostgreSQL (In-memory SQLite for tests)
# Goal: Prevent phantom token consumption and accidental secret leakage
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VIRTUAL ENVIRONMENT AND DEPENDENCIES (UV / PYTHON)
# ------------------------------------------------------------------------------
# Prevents AI from reading binary files or installed packages
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. DATABASE AND INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Prevents database dumps, caches, or SQLite files from inflating tokens
*.sql
*.sqlite3
db.sqlite3
*.dump
.data/

# ------------------------------------------------------------------------------
# 3. SECURITY AND API KEYS (CRUCIAL)
# ------------------------------------------------------------------------------
# Prevents AI from reading confidential environment variables or access tokens
.env
*.env
.env.*
secrets/
certs/
*.pem
*.key

# ------------------------------------------------------------------------------
# 4. LOGS AND TEMPORARY SYSTEM FILES
# ------------------------------------------------------------------------------
# Large logs snowball API token costs
*.log
logs/
tmp/
*.bak
*.swp
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# 5. DJANGO MIGRATION HISTORY
# ------------------------------------------------------------------------------
# AI only needs models.py for context; ignoring migrations saves significant tokens
**/migrations/*.py
**/migrations/__pycache__/

# ------------------------------------------------------------------------------
# 6. INTERNAL STATE AND AI AGENT CACHES
# ------------------------------------------------------------------------------
# Prevents tools from re-reading saved indexing history
.antigravitycli/
.codebase-memory/
.cursorignore
.cursorindexingignore

# ------------------------------------------------------------------------------
# 7. STATIC ASSETS, REPORTS AND NOTEBOOKS
# ------------------------------------------------------------------------------
staticfiles/
alliaadmin/static/
e2e_reports/
*.ipynb
ats/prompts/*.out
